# Production settings. Copy to /opt/ultimatepos/.env on the server, fill in every <...>, then: chmod 600 /opt/ultimatepos/.env
# Never commit the real file. Keep a copy in your password manager.
# Format: NAME=value, no quotes, no spaces around "=". A "__" in a name is a ":" in appsettings.json (Email__Smtp__Host = Email:Smtp:Host).

# ---------------------------------------------------------------- Address
# The domain the POS is served on. Its DNS A record must point at this server before the first start (for the HTTPS certificate).
SITE_ADDRESS=pos.yourcompany.co.ke
# The public website's domain. www.<this> redirects to it. Both DNS A records must point at this server before Caddy starts with them.
WEBSITE_ADDRESS=yourcompany.co.ke

# ---------------------------------------------------------------- Database
POSTGRES_DB=ultimatepos
POSTGRES_USER=ultimatepos
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=<random>
# The same database, as the API sees it. Host "db" is the database container. Use the same password as above.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=ultimatepos;Username=ultimatepos;Password=<same random>

# ---------------------------------------------------------------- Sign-in tokens
# Signs every sign-in token. Generate: openssl rand -base64 64 | tr -d '\n'   Changing it signs everyone out.
JwtSettings__Key=<random, 64+ characters>

# ---------------------------------------------------------------- First Super User
# Only for the very first start: sign in with it, change the password, then delete these three lines and run ./pos.sh up -d
Platform__BootstrapSuperUser__Email=you@yourcompany.co.ke
Platform__BootstrapSuperUser__FullName=Your Name
Platform__BootstrapSuperUser__Password=<strong temporary password>

# ---------------------------------------------------------------- Licensing (these are the defaults)
Licensing__Enforce=true
Licensing__TrialDays=14
Licensing__GraceDays=7

# ---------------------------------------------------------------- Notifications and email
# Links in emails point here.
Notifications__FrontendBaseUrl=https://pos.yourcompany.co.ke
Notifications__EmailEnabled=true
# SMS sending is not built yet (only the Log provider exists): keep false.
Notifications__SmsEnabled=false
# "Smtp" sends real email; "Log" only writes it to the API log.
Email__Provider=Smtp
Email__FromAddress=no-reply@yourcompany.co.ke
Email__FromName=Ultimate POS
# From your email provider (Brevo: smtp-relay.brevo.com, port 587, StartTls, your SMTP login and key).
Email__Smtp__Host=<smtp host>
Email__Smtp__Port=587
Email__Smtp__Security=StartTls
Email__Smtp__Username=<smtp username>
Email__Smtp__Password=<smtp password>

# ---------------------------------------------------------------- M-Pesa (Daraja production)
# Leave the sandbox values until Safaricom approves go-live. Production base URL: https://api.safaricom.co.ke
Mpesa__BaseUrl=https://sandbox.safaricom.co.ke
Mpesa__ConsumerKey=<from the Daraja app>
Mpesa__ConsumerSecret=<from the Daraja app>
# STK push uses this one short code and passkey for EVERY business: all STK payments land in this account.
Mpesa__ShortCode=<short code>
Mpesa__Passkey=<Lipa Na M-Pesa Online passkey>
# Daraja refuses C2B URLs containing "mpesa" or "safaricom", so use the /payments/ paths.
Mpesa__StkCallbackUrl=https://pos.yourcompany.co.ke/api/v1/payments/stk/callback
Mpesa__C2bConfirmationUrl=https://pos.yourcompany.co.ke/api/v1/payments/c2b/confirmation
Mpesa__C2bValidationUrl=https://pos.yourcompany.co.ke/api/v1/payments/c2b/validation
# Optional: only accept callbacks from Safaricom's addresses (CIDR), one per line, numbered from 0. Take the current list from
# Safaricom (Daraja support); a wrong list silently drops real payments, so test with a real payment after setting it.
# Mpesa__CallbackIpAllowlist__0=<Safaricom range, e.g. a.b.c.0/24>
# Mpesa__CallbackIpAllowlist__1=<next range>

# ---------------------------------------------------------------- KRA eTIMS (OSCU)
# One Apigee app (developer.go.ke) for the whole platform; every business reports through it. Without the key, secret and app id
# nothing is sent to KRA. Keep the sandbox URLs until KRA certifies the integration, then change all three URLs together
# (see docs/ETIMS.md).
Etims__ConsumerKey=<from the developer.go.ke app>
Etims__ConsumerSecret=<from the developer.go.ke app>
Etims__ApigeeAppId=<from the developer.go.ke app>
Etims__BaseUrl=https://sbx.kra.go.ke/etims-oscu/api/v1
Etims__TokenUrl=https://sbx.kra.go.ke/v1/token/generate
Etims__ReceiptVerificationUrl=https://etims-sbx.kra.go.ke/common/link/etims/receipt/indexEtimsReceiptData?Data=

# ---------------------------------------------------------------- Shown to users on blocking screens (optional; rebuild web after changing)
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ---------------------------------------------------------------- Website (optional; rebuild after changing: ./pos.sh build site)
# Public values fixed into the website when it is built. Its runtime secrets (email, Turnstile secret, rate limiting) are NOT here:
# they live in website.env, next to this file, chmod 600, started from the website repo's .env.example.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
META_DOMAIN_VERIFICATION=
FACEBOOK_APP_ID=

# ---------------------------------------------------------------- Backups (backup.sh)
# rclone remote and bucket for the off-server copy, e.g. b2:ultimatepos-backups (set up with: rclone config)
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=60
