{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Issuer": "ultimatepos-api",
    "Audience": "ultimatepos-client",
    "ExpiryMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Mpesa": {
    "BaseUrl": "https://sandbox.safaricom.co.ke",
    "ConsumerKey": "",
    "ConsumerSecret": "",
    "ShortCode": "174379",
    "Passkey": "",
    "StkCallbackUrl": "https://yourdomain.com/api/v1/payments/stk/callback",
    "C2bConfirmationUrl": "https://yourdomain.com/api/v1/payments/c2b/confirmation",
    "C2bValidationUrl": "https://yourdomain.com/api/v1/payments/c2b/validation",
    "CallbackIpAllowlist": []
  },
  "Etims": {
    "BaseUrl": "https://sbx.kra.go.ke/etims-oscu/api/v1",
    "TokenUrl": "https://sbx.kra.go.ke/v1/token/generate",
    "ConsumerKey": "",
    "ConsumerSecret": "",
    "ApigeeAppId": "",
    "TimeoutSeconds": 30,
    "WorkersEnabled": true,
    "IntervalSeconds": 15,
    "MaxAttempts": 10,
    "BatchSize": 50,
    "ReceiptVerificationUrl": "https://etims-sbx.kra.go.ke/common/link/etims/receipt/indexEtimsReceiptData?Data="
