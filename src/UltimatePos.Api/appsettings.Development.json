{
  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Notifications": {
    "EmailEnabled": true,
    "SmsEnabled": true,
    "FrontendBaseUrl": "http://localhost:5173",
    "SweepIntervalMinutes": 15
  },
  "Email": {
    "Provider": "Log"
  },
  "Sms": {
    "Provider": "Log"
  }
}
